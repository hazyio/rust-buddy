{
  "name": "rust-buddy",
  "displayName": "Rust Buddy",
  "description": "Rust productivity toolkit for VS Code — manage crates, scaffold files and modules, and more.",
  "version": "0.0.1",
  "publisher": "hazyio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hazyio/rust-buddy"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/Cargo.toml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "rust-buddy.createProject",
        "title": "Rust Buddy: Create Project (Standalone Crate)"
      },
      {
        "command": "rust-buddy.createWorkspace",
        "title": "Rust Buddy: Create Workspace"
      },
      {
        "command": "rust-buddy.addCrateToWorkspace",
        "title": "Rust Buddy: Add Crate to Workspace"
      },
      {
        "command": "rust-buddy.addCrateToWorkspaceFromContext",
        "title": "Rust Buddy: Add Crate to Workspace"
      },
      {
        "command": "rust-buddy.addDirModuleModFromContext",
        "title": "Rust Buddy: New directory module with mod.rs"
      },
      {
        "command": "rust-buddy.addFileModuleFromContext",
        "title": "Rust Buddy: New file module"
      },
      {
        "command": "rust-buddy.addDirModuleFromContext",
        "title": "Rust Buddy: New directory module"
      },
      {
        "command": "rust-buddy.createWorkspaceFromContext",
        "title": "Rust Buddy: Create workspace"
      },
      {
        "command": "rust-buddy.createProjectFromContext",
        "title": "Rust Buddy: Create Rust Project (Standalone Crate)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "rust-buddy.addCrateToWorkspaceFromContext",
          "when": "false"
        },
        {
          "command": "rust-buddy.addDirModuleModFromContext",
          "when": "false"
        },
        {
          "command": "rust-buddy.addFileModuleFromContext",
          "when": "false"
        },
        {
          "command": "rust-buddy.addDirModuleFromContext",
          "when": "false"
        },
        {
          "command": "rust-buddy.createWorkspaceFromContext",
          "when": "false"
        },
        {
          "command": "rust-buddy.createProjectFromContext",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "rust-buddy.addCrateToWorkspaceFromContext",
          "when": "explorerResourceIsFolder && resourcePath in rust-buddy.cargoWorkspaceRoots",
          "group": "1_rustbuddy@1"
        },
        {
          "command": "rust-buddy.createProjectFromContext",
          "when": "explorerResourceIsFolder && !(resourcePath in rust-buddy.cargoWorkspaceRoots) && !(resourcePath in rust-buddy.rustCrateRoots)",
          "group": "1_rustbuddy@1"
        },
        {
          "command": "rust-buddy.createWorkspaceFromContext",
          "when": "explorerResourceIsFolder && !(resourcePath in rust-buddy.cargoWorkspaceRoots) && !(resourcePath in rust-buddy.rustCrateRoots)",
          "group": "1_rustbuddy@2"
        },
        {
          "command": "rust-buddy.addFileModuleFromContext",
          "when": "explorerResourceIsFolder && resourcePath in rust-buddy.rustCrateRoots",
          "group": "1_rustbuddy@3"
        },
        {
          "command": "rust-buddy.addDirModuleFromContext",
          "when": "explorerResourceIsFolder && resourcePath in rust-buddy.rustCrateRoots",
          "group": "1_rustbuddy@4"
        },
        {
          "command": "rust-buddy.addDirModuleModFromContext",
          "when": "explorerResourceIsFolder && resourcePath in rust-buddy.rustCrateRoots",
          "group": "1_rustbuddy@5"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
